# Copy to .env and fill in. Never commit .env.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-please

# Group id of the Docker socket on your host:  stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Filled in by scripts/bootstrap-sonarqube.sh
SONAR_TOKEN=

# GitHub username and a personal access token with write:packages, to push images to ghcr.io
REGISTRY_USER=
REGISTRY_PASSWORD=

SONAR_DB_PASSWORD=sonar-local-only
